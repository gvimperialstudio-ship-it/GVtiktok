# Placeholders only. Copy to .env and replace every change-me value.
# .env is gitignored. Never put real certificates, passwords, or tokens in git.

POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp

# Host-side tools (alembic, uvicorn on the host) use localhost.
# docker-compose overrides DATABASE_URL and REDIS_URL to the compose service names.
DATABASE_URL=postgresql+asyncpg://erp:change-me@localhost:5432/erp
REDIS_URL=redis://localhost:6379/0

# Stock sync workers only log the PUT they would send while this is true.
SHADOW_MODE=true

# local reads env: and file: refs. oci_vault is a stub in this PR.
SECRETS_PROVIDER=local

# References, not the secret values. The local provider resolves env:NAME.
OPS_BEARER_TOKEN_REF=env:OPS_BEARER_TOKEN
OPS_BEARER_TOKEN=change-me

WEBHOOK_HMAC_SECRET_REF=env:WEBHOOK_HMAC_SECRET
WEBHOOK_HMAC_SECRET=change-me

# Empty URL keeps the notifier in stub mode (sign + log, no HTTP).
WEBHOOK_URL=

LOG_LEVEL=INFO

# Dedicated database for pytest. The test run DROPs the public schema of this database.
# The name must contain "test". Do not point this at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://erp:change-me@localhost:5432/erp_test
TEST_REDIS_URL=redis://localhost:6379/0
